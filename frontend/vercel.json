{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "build",
  "env": {
    "SKIP_FORK_TS_CHECKER": "true",
    "TSC_SKIP_TYPECHECK": "true"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "${REACT_APP_BACKEND_URL}/api/$1"
    }
  ]
}
